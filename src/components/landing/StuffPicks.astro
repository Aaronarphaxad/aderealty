---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import FancyLink from "@/components/fundations/elements/FancyLink.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import ProperyInfoCard from "@/components/properties/ProperySmallCard.astro";
// Content
import { getCollection } from "astro:content";
const allProperties = await getCollection("properties");
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="flex flex-wrap lg:items-center lg:justify-between">
      <Text
        tag="h2"
        variant="displayLG"
        class="font-semibold leading-none text-foreground tracking-tight text-balance uppercase"
        >Staff picks</Text
      >
      <FancyLink href="/properties"> Browse listings </FancyLink>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-x-8 gap-y-12 mt-12">
      {
        allProperties
          .filter((property) => property.data.isStaffPick)
          .slice(0, 3)
          .map((property) => <ProperyInfoCard property={property} />)
      }
    </div>
  </Wrapper>
</section>
