---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Content
const { title, description, url, image, pubDate } = {
  url: "/blog/posts/" + Astro.props.post.id,
  title: Astro.props.post.data.title,
  description: Astro.props.post.data.description,
  image: Astro.props.post.data.image.url,
  pubDate: Astro.props.post.data.pubDate,
};

const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<article class="relative flex flex-col gap-4 group">
  <a
    href={url}
    title={`Read more: ${title}`}
    aria-label={`Read blog post: ${title}`}
    class="absolute inset-0 z-10"></a>
  <div>
    <Text tag="h3" variant="textSM" class="font-medium text-foreground"
      >{title}
    </Text>
    <Text tag="p" variant="textSM" class="text-muted-foreground">
      {formattedDate}
    </Text>
    <Text tag="p" variant="textXS" class="mt-1 text-muted-foreground">
      {description}
    </Text>
  </div>
  <div class="relative order-first overflow-hidden rounded-lg">
    <Image
      src={image}
      alt={title}
      width={1000}
      height={667}
      widths={[480, 800, 1000]}
      sizes="(min-width: 1024px) 33vw, 100vw"
      class="object-cover object-center w-full aspect-12/8 transition duration-300 ease-out group-hover:scale-105"
    />
  </div>
</article>
