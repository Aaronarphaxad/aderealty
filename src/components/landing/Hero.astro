---
// Assets
import { Image } from "astro:assets";
import HeroImage from "@/images/agent/hero-house.webp";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="flex flex-col justify-between">
      <Text
        tag="h1"
        variant="display3XL"
        class="font-medium tracking-tighter text-foreground"
      >
        <span
          aria-hidden="true"
          class="block mb-4 md:inline-block md:align-bottom md:mb-0 overflow-hidden rounded-lg"
        >
          <Image
            src={HeroImage}
            alt=""
            width={580}
            height={580}
            loading="eager"
            fetchpriority="high"
            class="block object-cover size-full object-center transition-all duration-700 ease-out hover:scale-105 w-full md:max-w-38 lg:max-w-58 2xl:max-w-60 h-70 md:h-auto"
          />
        </span>
        Nordic homes, bought and sold with care.
      </Text>
      <div class="max-w-sm mt-20">
        <Text tag="p" variant="textLG" class="text-muted-foreground">
          Expert guidance through every step of your real estate journey, from
          first viewing to final keys.
        </Text>
      </div>
    </div>
  </Wrapper>
</section>
