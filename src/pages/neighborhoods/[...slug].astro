---
import { getCollection, render } from "astro:content";
import NeighborhoodsLayout from "@/layouts/NeighborhoodsLayout.astro";
export async function getStaticPaths() {
  const neighborhoods = await getCollection("neighborhoods");
  const paths = neighborhoods.map((page) => {
    return {
      params: { slug: page.id },
      props: { page },
      trailingSlash: false,
    };
  });
  return paths;
}
const { page } = Astro.props;
const { Content } = await render(page);
---

<NeighborhoodsLayout frontmatter={page.data}>
  <Content />
</NeighborhoodsLayout>
