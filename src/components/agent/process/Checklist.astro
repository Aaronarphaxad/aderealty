---
interface Props {
  title: string;
  items: { label: string; done?: boolean }[];
}

const { title, items } = Astro.props;
const doneCount = items.filter((item) => item.done).length;
---

<div data-checklist>
  <div class="flex items-baseline justify-between gap-2">
    <p class="text-xs text-muted-foreground">{title}</p>
    <p class="text-xs text-muted-foreground tabular-nums" aria-live="polite">
      <span data-checklist-count>{doneCount}</span>{` of ${items.length}`}
    </p>
  </div>
  <ul class="mt-3 space-y-2" role="list">
    {
      items.map((item) => (
        <li>
          <label class="flex items-center gap-2 cursor-pointer">
            <input
              type="checkbox"
              checked={item.done}
              autocomplete="off"
              class="rounded cursor-pointer peer size-4 shrink-0 border-muted-foreground text-foreground focus:ring-foreground"
            />
            <span class="text-xs font-medium transition-colors text-foreground peer-checked:line-through peer-checked:text-muted-foreground">
              {item.label}
            </span>
          </label>
        </li>
      ))
    }
  </ul>
</div>
