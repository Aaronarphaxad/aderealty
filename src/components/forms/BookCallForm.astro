---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
---

<form class="space-y-6">
  <div class="space-y-1">
    <label for="name" class="block text-sm text-foreground"> Full Name * </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
      placeholder="Oskar Brandt"
    />
  </div>
  <div class="space-y-1">
    <label for="email" class="block text-sm text-foreground">
      Email Address *
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
      placeholder="oskar@brandt.test"
    />
  </div>
  <div class="space-y-1">
    <label for="phone" class="block text-sm text-foreground">
      Phone Number *
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      required
      class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
      placeholder="+45 00 00 00 00"
    />
  </div>
  <div class="space-y-1">
    <label for="callType" class="block text-sm text-foreground">
      What would you like to discuss? *
    </label>
    <select
      id="callType"
      name="callType"
      required
      class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
    >
      <option value="">Select an option</option>
      <option value="buying">Buying a property</option>
      <option value="selling">Selling a property</option>
      <option value="renting">Renting a property</option>
      <option value="investing">Investment opportunities</option>
      <option value="valuation">Property valuation</option>
      <option value="general">General inquiry</option>
    </select>
  </div>
  <div class="grid sm:grid-cols-2 gap-6">
    <div class="space-y-1">
      <label for="preferredDate" class="block text-sm text-foreground">
        Preferred Date *
      </label>
      <input
        type="date"
        id="preferredDate"
        name="preferredDate"
        required
        class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
      />
    </div>
    <div class="space-y-1">
      <label for="preferredTime" class="block text-sm text-foreground">
        Preferred Time *
      </label>
      <select
        id="preferredTime"
        name="preferredTime"
        required
        class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
      >
        <option value="">Select a time</option>
        <option value="09:00">09:00 AM</option>
        <option value="10:00">10:00 AM</option>
        <option value="11:00">11:00 AM</option>
        <option value="12:00">12:00 PM</option>
        <option value="13:00">01:00 PM</option>
        <option value="14:00">02:00 PM</option>
        <option value="15:00">03:00 PM</option>
        <option value="16:00">04:00 PM</option>
        <option value="17:00">05:00 PM</option>
      </select>
    </div>
  </div>
  <div class="space-y-1">
    <label for="callMethod" class="block text-sm text-foreground">
      Preferred Call Method *
    </label>
    <div class="grid sm:grid-cols-3 gap-4">
      <label class="flex items-center gap-3">
        <input type="radio" name="callMethod" value="phone" class="w-4 h-4" />
        <span class="text-sm text-foreground"> Phone call </span>
      </label>
      <label class="flex items-center gap-3">
        <input type="radio" name="callMethod" value="video" class="w-4 h-4" />
        <span class="text-sm text-foreground"> Video call </span>
      </label>
      <label class="flex items-center gap-3">
        <input
          type="radio"
          name="callMethod"
          value="in-person"
          class="w-4 h-4"
        />
        <span class="text-sm text-foreground"> In Person </span>
      </label>
    </div>
  </div>
  <div class="space-y-1">
    <label for="message" class="block text-sm text-foreground">
      Additional details
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class="w-full px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 resize-none"
      placeholder="Tell us more about what you'd like to discuss..."></textarea>
  </div>
  
  <Button variant="muted" size="xs" type="submit" class="w-fit mt-12">
    Request consultation
  </Button>
  
</form>
