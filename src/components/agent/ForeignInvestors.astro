---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import SectionHeading from "@/components/agent/SectionHeading.astro";
// Data
import { agent } from "@/lib/agent";

const points = [
  {
    title: "New construction and presale",
    description: "Off-plan and assignment opportunities reviewed for deposit structure, timeline and developer track record.",
  },
  {
    title: "A remote buying process",
    description: "Video walkthroughs, digital signing and a single point of contact across time zones.",
  },
  {
    title: "Legal and tax referrals",
    description: "Introductions to BC lawyers, accountants and lenders who work with non-resident buyers.",
  },
];
---

<section id="foreign-investors" class="scroll-mt-20">
  <Wrapper variant="standard" class="py-24">
    <SectionHeading title="International investors">
      Foreign and diaspora buyers looking at new construction, presale and off-plan homes across
      Surrey and the Lower Mainland.
    </SectionHeading>
    <div class="grid grid-cols-1 gap-3 mt-12 lg:grid-cols-12">
      <div class="flex flex-col justify-between gap-8 p-6 rounded-2xl bg-tint-sky lg:col-span-5">
        <div>
          <Text
            tag="h3"
            variant="displaySM"
            class="font-semibold leading-tight tracking-tight text-foreground text-balance"
          >
            Invest from abroad with a clear local guide.
          </Text>
          <Text tag="p" variant="textBase" class="mt-4 text-foreground/70 text-pretty">
            {agent.shortName} helps overseas and diaspora clients navigate BC rules, shortlists and
            developer deals, then stays on the file through completion.
          </Text>
        </div>
        <Button isLink={true} href={agent.bookingUrl} target="_blank" rel="noopener noreferrer" variant="default" size="sm" class="w-fit">
          Book a discovery call
        </Button>
      </div>
      <div class="flex flex-col justify-between gap-8 p-6 rounded-2xl bg-muted lg:col-span-7">
        <Text tag="h3" variant="textBase" class="font-medium text-foreground">
          What the service covers
        </Text>
        <ul class="p-4 rounded-xl bg-background" role="list">
          {
            points.map((point) => (
              <li class="py-3 border-t border-border first:border-0 first:pt-0 last:pb-0">
                <Text tag="h4" variant="textSM" class="font-medium text-foreground">
                  {point.title}
                </Text>
                <Text tag="p" variant="textSM" class="mt-1 text-muted-foreground text-pretty">
                  {point.description}
                </Text>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <Text tag="p" variant="textXS" class="max-w-3xl mt-4 text-muted-foreground text-pretty">
      This is general information, not legal or tax advice. BC's additional property transfer
      tax for foreign buyers and other provincial rules may still apply.
    </Text>
  </Wrapper>
</section>
