---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import { formatEuro } from "@/lib/properties";
// Content
const { name, tagline, url, coverImage } = {
  url: "/neighborhoods/" + Astro.props.neighborhood.id,
  name: Astro.props.neighborhood.data.name,
  tagline: Astro.props.neighborhood.data.tagline,
  coverImage: Astro.props.neighborhood.data.coverImage?.url,
};
const { city, avgPricePerSqm } = Astro.props.neighborhood.data;
---

<article class="relative flex flex-col gap-4 group">
  <a
    href={url}
    title={`Explore: ${name}`}
    aria-label={`Explore neighborhood: ${name}`}
    class="absolute inset-0 z-10"></a>
  <div>
    <Text tag="h3" variant="textSM" class="font-medium text-foreground">
      {name}
    </Text>
    <Text tag="p" variant="textSM" class="text-muted-foreground">
      {tagline}
    </Text>
    <Text tag="p" variant="textXS" class="mt-1 text-foreground">
      {city}, {formatEuro(avgPricePerSqm)} per m² on average
    </Text>
  </div>
  <div class="relative order-first overflow-hidden rounded-lg">
    {
      coverImage && (
        <Image
          src={coverImage}
          alt={name}
          width={1000}
          height={667}
          class="object-cover object-center w-full aspect-12/8 transition duration-300 ease-out group-hover:scale-105"
        />
      )
    }
  </div>
</article>
