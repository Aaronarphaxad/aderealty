---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import HeadingWrapper from "@/components/fundations/containers/HeadingWrapper.astro";
import Text from "@/components/fundations/elements/Text.astro";

const groups = [
  {
    title: "Grounds",
    text: "The page, the grey behind chips and muted buttons, and the hairlines between rows.",
    colors: [
      { name: "Background", token: "--color-background", class: "bg-background outline outline-border -outline-offset-1" },
      { name: "Muted", token: "--color-muted", class: "bg-muted" },
      { name: "Border", token: "--color-border", class: "bg-border" },
    ],
  },
  {
    title: "Ink",
    text: "Headings and buttons in near black, body copy in grey, and the one blue kept for links and the call button.",
    colors: [
      { name: "Foreground", token: "--color-foreground", class: "bg-foreground" },
      { name: "Muted foreground", token: "--color-muted-foreground", class: "bg-muted-foreground" },
      { name: "Accent", token: "--color-accent", class: "bg-accent" },
    ],
  },
];
---

{
  groups.map((group) => (
    <section>
      <Wrapper variant="standard" class="pb-24">
        <div class="pt-12 border-t border-border">
          <HeadingWrapper text={group.title}>
            <Text tag="p" variant="textLG" class="text-muted-foreground text-balance">
              {group.text}
            </Text>
            <ul class="grid grid-cols-1 mt-12 sm:grid-cols-3 gap-x-8 gap-y-12">
              {group.colors.map((color) => (
                <li>
                  <span class:list={["block rounded-lg aspect-4/3", color.class]} aria-hidden="true" />
                  <div class="pt-2 mt-4 border-t border-border">
                    <Text tag="h3" variant="textBase" class="font-medium text-foreground">
                      {color.name}
                    </Text>
                    <Text tag="p" variant="textXS" class="mt-1 text-muted-foreground">
                      {color.token}
                    </Text>
                  </div>
                </li>
              ))}
            </ul>
          </HeadingWrapper>
        </div>
      </Wrapper>
    </section>
  ))
}
