---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import FancyLink from "@/components/fundations/elements/FancyLink.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { formatEuro, getRecentSales, propertyUrl } from "@/lib/properties";
const sales = await getRecentSales();
const columns = ["Home", "Asking", "Sold for", "Difference", "Days on market"];
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="flex flex-wrap gap-8 lg:items-end lg:justify-between">
      <div class="lg:w-1/2">
        <Text
          tag="h2"
          variant="displayLG"
          class="font-semibold leading-none uppercase text-foreground tracking-tight text-balance"
        >
          Recently sold
        </Text>
        <Text tag="p" variant="textLG" class="mt-4 text-muted-foreground text-pretty">
          The asking price, the final price and how long it took. No averages.
        </Text>
      </div>
      <FancyLink href="/properties/sold">All sold homes</FancyLink>
    </div>
    <div class="mt-12">
      <div class="hidden grid-cols-6 gap-4 pb-4 text-xs border-b lg:grid text-muted-foreground border-border" aria-hidden="true">
        {columns.map((column, index) => <span class={index === 0 ? "col-span-2" : ""}>{column}</span>)}
      </div>
      <ul role="list">
        {
          sales.map((sale) => (
            <li class="relative grid grid-cols-2 gap-4 py-6 border-b group lg:grid-cols-6 border-border">
              <a href={propertyUrl(sale.property)} class="absolute inset-0 z-10" aria-label={`View ${sale.property.data.title}`} />
              <div class="col-span-2">
                <Text tag="h3" variant="textBase" class="font-medium transition-colors text-foreground group-hover:text-accent">
                  {sale.property.data.title}
                </Text>
                <Text tag="p" variant="textSM" class="text-muted-foreground">
                  {sale.property.data.city}
                </Text>
              </div>
              <dl class="contents">
                <div>
                  <dt class="text-xs lg:sr-only text-muted-foreground">Asking</dt>
                  <dd class="text-sm text-muted-foreground">{formatEuro(sale.asking)}</dd>
                </div>
                <div>
                  <dt class="text-xs lg:sr-only text-muted-foreground">Sold for</dt>
                  <dd class="text-sm font-medium text-foreground">{formatEuro(sale.final)}</dd>
                </div>
                <div>
                  <dt class="text-xs lg:sr-only text-muted-foreground">Difference</dt>
                  <dd class:list={["text-sm", sale.difference >= 0 ? "text-accent" : "text-muted-foreground"]}>
                    {sale.difference > 0 ? "+" : ""}{sale.difference}%
                  </dd>
                </div>
                <div>
                  <dt class="text-xs lg:sr-only text-muted-foreground">Days on market</dt>
                  <dd class="text-sm text-foreground">{sale.daysOnMarket} days</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </Wrapper>
</section>
