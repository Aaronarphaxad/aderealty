---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import FancyLink from "@/components/fundations/elements/FancyLink.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import AgentCard from "@/components/agents/AgentCard.astro";
// Content
import { getCollection } from "astro:content";
const agents = await getCollection("agents");
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="flex flex-wrap gap-8 lg:items-end lg:justify-between">
      <div class="lg:w-1/2">
        <Text
          tag="h2"
          variant="displayLG"
          class="font-semibold leading-none uppercase text-foreground tracking-tight text-balance"
        >
          Your agent
        </Text>
        <Text tag="p" variant="textLG" class="mt-4 text-muted-foreground text-pretty">
          One agent from valuation to keys, in the city you are buying or selling in.
        </Text>
      </div>
      <FancyLink href="/agents">All agents</FancyLink>
    </div>
    <div class="grid grid-cols-2 mt-12 md:grid-cols-3 lg:grid-cols-6 gap-x-8 gap-y-12">
      {agents.map((agent) => <AgentCard agent={agent} />)}
    </div>
  </Wrapper>
</section>
