---
import { Image } from "astro:assets";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import HeadingWrapper from "@/components/fundations/containers/HeadingWrapper.astro";
const { frontmatter, facts } = Astro.props;
---

<section>
  <Wrapper variant="standard" class="py-24 lg:pt-48">
    <HeadingWrapper text="Neighborhoods">
      <Text
        tag="h1"
        variant="displayLG"
        class="font-semibold leading-none text-foreground tracking-tight text-balance"
      >
        {frontmatter.name}
      </Text>
      <Text tag="p" variant="textLG" class="mt-4 text-muted-foreground text-pretty">
        {frontmatter.tagline}
      </Text>
      <Text tag="p" variant="textBase" class="mt-6 text-foreground">
        {frontmatter.summary}
      </Text>
      <dl class="grid grid-cols-1 gap-8 pt-4 mt-12 border-t sm:grid-cols-2 lg:grid-cols-4 border-border">
        {
          facts.map((fact) => (
            <div>
              <dt class="text-xs text-muted-foreground">{fact.label}</dt>
              <dd class="mt-1 text-sm font-medium text-foreground text-pretty">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="grid grid-cols-1 gap-4 mt-12 lg:grid-cols-3">
        <Text tag="h3" variant="textBase" class="font-semibold text-foreground">
          Neighborhood highlights
        </Text>
        <ul class="lg:columns-2 gap-y-3 gap-x-8 lg:col-span-2" role="list">
          {
            frontmatter.highlights.map((highlight) => (
              <li class="text-sm text-muted-foreground">{highlight}</li>
            ))
          }
        </ul>
      </div>
    </HeadingWrapper>
    <Image
      src={frontmatter.coverImage.url}
      alt={frontmatter.coverImage.alt}
      width={1480}
      height={1200}
      loading="eager"
      fetchpriority="high"
      widths={[640, 1024, 1480]}
      sizes="100vw"
      decoding="async"
      class="object-cover size-full object-center mt-12 rounded-2xl max-h-200"
    />
  </Wrapper>
</section>
