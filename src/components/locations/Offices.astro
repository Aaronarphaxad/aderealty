---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FancyLink from "@/components/fundations/elements/FancyLink.astro";
import HeadingWrapper from "@/components/fundations/containers/HeadingWrapper.astro";
const officeCategories = [
  {
    name: "Denmark",
    offices: [
      {
        city: "Copenhagen",
        address: "Bredgade 34, 1260 Copenhagen K",
        email: "copenhagen@westend.test",
        phone: "+45 00 00 00 01",
      },
    ],
  },
  {
    name: "Sweden",
    offices: [
      {
        city: "Stockholm",
        address: "Strandvägen 21, 114 56 Stockholm",
        email: "stockholm@westend.test",
        phone: "+46 0 000 00 02",
      },
    ],
  },
  {
    name: "Norway",
    offices: [
      {
        city: "Oslo",
        address: "Bygdøy allé 15, 0262 Oslo",
        email: "oslo@westend.test",
        phone: "+47 00 00 00 03",
      },
    ],
  },
  {
    name: "Finland",
    offices: [
      {
        city: "Helsinki",
        address: "Pohjoisesplanadi 25, 00100 Helsinki",
        email: "helsinki@westend.test",
        phone: "+358 0 000 0004",
      },
    ],
  },
];
---

<section>
  <Wrapper variant="standard" class="py-24">
    <HeadingWrapper text="offices">
      <Text
        tag="h2"
        variant="displayLG"
        class="font-semibold leading-none text-foreground tracking-tight text-balance"
      >
        Find us
      </Text>
      <Text tag="p" variant="textLG" class="mt-8 text-muted-foreground">
        Four offices, in Copenhagen, Stockholm, Oslo and Helsinki.
      </Text>
      <FancyLink class="mt-8" href="/book-a-call">Book a call</FancyLink>
      <div class="space-y-12 mt-24">
        {
          officeCategories.map((category) => (
            <div class="pb-8 ">
              <Text
                tag="h3"
                variant="displayMD"
                class="font-semibold leading-none text-foreground tracking-tight text-balance"
              >
                {category.name}
              </Text>
              <div class="flex flex-col  lg:col-span-2 mt-4  border-t border-border divide-y divide-border">
                {category.offices.map((office) => (
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 py-4">
                    <Text
                      tag="h4"
                      variant="textXS"
                      class="uppercase text-foreground font-semibold"
                    >
                      {office.city}
                    </Text>
                    <div class="space-y-1 lg:col-span-2">
                      <address class="text-sm not-italic text-muted-foreground ">
                        {office.address}
                      </address>
                      <a
                        href="#_"
                        class="block text-sm text-muted-foreground  hover:text-foreground transition-colors"
                      >
                        {office.email}
                      </a>
                      <a
                        href="#_"
                        class="block text-sm text-muted-foreground  hover:text-foreground transition-colors"
                      >
                        {office.phone}
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </HeadingWrapper>
  </Wrapper>
</section>
