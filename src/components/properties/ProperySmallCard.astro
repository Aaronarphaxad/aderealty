---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import { formatEuro, formatViewingDate, getNextViewings, priceText, pricePerSqm, propertyUrl } from "@/lib/properties";

const { property } = Astro.props;
const { title, city, country, bedrooms, bathrooms, areaSqm, propertyType, status, energyClass } = property.data;
const image = property.data.coverImage.url;
const url = propertyUrl(property);
const perSqm = pricePerSqm(property);
const viewing = (await getNextViewings()).get(property.id);

const formatLabel = (value?: string | null) => {
  if (!value) return null;
  const label = value.replace(/-/g, " ");
  return label.charAt(0).toUpperCase() + label.slice(1);
};
const specChips = [
  formatLabel(propertyType),
  formatLabel(status),
  bedrooms != null ? `${bedrooms} beds` : null,
  bathrooms != null ? `${bathrooms} baths` : null,
  areaSqm != null ? `${areaSqm} m²` : null,
  energyClass ? `Energy ${energyClass}` : null,
].filter((spec): spec is string => Boolean(spec));
---

<article class="relative flex flex-col gap-4 group">
  <a
    href={url}
    title={`View property: ${title}`}
    aria-label={`View property: ${title}`}
    class="absolute inset-0 z-10"></a>
  <div>
    <Text tag="h3" variant="textSM" class="font-medium text-foreground"
      >{title}
    </Text>
    <Text tag="p" variant="textSM" class="text-muted-foreground">
      {[city, country].filter(Boolean).join(", ")}
    </Text>
    <Text tag="p" variant="textXS" class="mt-1 text-foreground">
      {priceText(property)}
      {perSqm && <span class="text-muted-foreground">, {formatEuro(perSqm)} per m²</span>}
    </Text>
    {
      viewing && (
        <Text tag="p" variant="textXS" class="mt-1 text-accent">
          Viewing {formatViewingDate(viewing.data.date)}, {viewing.data.startTime}
        </Text>
      )
    }
  </div>
  <div class="relative order-first overflow-hidden rounded-lg">
    {
      specChips.length > 0 && (
        <div class="absolute inset-0 z-10 flex items-end justify-start w-full pointer-events-none">
          <ul class="flex items-center justify-between w-full px-3 py-1 text-background opacity-0 gap-4  bg-foreground/20 backdrop-blur-sm translate-y-2 transition duration-300 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:translate-y-0 motion-reduce:transition-none motion-reduce:transform-none">
            {specChips.map((spec) => (
              <li>
                <Text
                  tag="span"
                  variant="textXXS"
                >
                  {spec}
                </Text>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <Image
      src={image}
      alt={title}
      width={1000}
      height={667}
      widths={[480, 800, 1000]}
      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
      class="object-cover object-center w-full aspect-12/8 transition duration-300 ease-out group-hover:scale-105"
    />
  </div>
</article>
