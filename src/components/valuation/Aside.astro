---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
---
<div class="lg:sticky lg:top-24 space-y-8">
  <div>
    <Text tag="h3" variant="textLG" class="font-medium text-foreground">
      Prefer to talk first?
    </Text>
    <div class="text-sm space-y-3 mt-4">
      <div>
        <Text tag="p" variant="textXS" class="mb-1 text-muted-foreground"> Email </Text>
        <a
          href="#_"
          class="font-medium text-muted-foreground hover:text-foreground"
        >
          hello@westend.test
        </a>
      </div>
      <div>
        <Text tag="p" variant="textXS" class="mb-1 text-muted-foreground"> Phone </Text>
        <a href="#_" class="font-medium text-muted-foreground hover:text-foreground">
          +45 0 000 0000
        </a>
      </div>
    </div>
  </div>
</div>
