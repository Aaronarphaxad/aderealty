---
// Assets
import { Image } from "astro:assets";
import HeroHouse from "@/images/agent/hero-house.webp";
import FirstHome from "@/images/agent/first-home.webp";
import VideoTour from "@/images/agent/video-tour.jpg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Play from "@/components/fundations/icons/Play.astro";
import FloorPlan from "@/components/fundations/icons/FloorPlan.astro";
// Components
import SectionHeading from "@/components/agent/SectionHeading.astro";
import StepCard from "@/components/agent/process/StepCard.astro";
import Checklist from "@/components/agent/process/Checklist.astro";
// Data
import { agent } from "@/lib/agent";

const tabs = [
  { id: "buying", label: "Buying" },
  { id: "selling", label: "Selling" },
];

// Example content for the cards. Every figure here is illustrative.
const preApproval = [
  { label: "Photo ID", done: true },
  { label: "Proof of income", done: true },
  { label: "Down payment statements" },
  { label: "Credit check consent" },
];
const shortlist = [
  { home: "Townhome, Clayton", beds: "3 bed" },
  { home: "Condo, Fleetwood", beds: "2 bed" },
  { home: "Townhome, Cloverdale", beds: "3 bed" },
];
const newListings = 14;
const subjects = [
  { label: "Financing approved", done: true },
  { label: "Home inspection", done: true },
  { label: "Strata documents read" },
  { label: "Title and insurance" },
];
const milestones = [
  { label: "Offer accepted", day: "Day 1" },
  { label: "Subjects removed", day: "Day 7" },
  { label: "Deposit paid", day: "Day 8" },
  { label: "Completion", day: "Day 45" },
  { label: "Keys in hand", day: "Day 46" },
];
const comparables = [
  { label: "Sold nearby, 3 bed", price: "$889K" },
  { label: "Sold nearby, 3 bed", price: "$905K" },
  { label: "Sold nearby, 4 bed", price: "$928K" },
];
const preparation = [
  { label: "Declutter and deep clean", done: true },
  { label: "Touch-up paint", done: true },
  { label: "Styling walkthrough" },
  { label: "Strata documents ordered" },
];
const offers = [
  { price: "$912K", terms: "Financing, 60 days" },
  { price: "$905K", terms: "No subjects, 30 days", strongest: true },
  { price: "$898K", terms: "Inspection, 45 days" },
];

const cardTitleClass = "text-xs text-muted-foreground";
const figureClass = "mt-2 text-xl font-semibold leading-none tracking-tight text-foreground";
const rowClass = "flex items-baseline justify-between gap-2";
const rowLabelClass = "text-xs font-medium text-foreground";
const rowValueClass = "text-xs text-muted-foreground tabular-nums";
const gridClass = "grid grid-cols-1 mt-12 gap-x-4 sm:grid-cols-2 xl:grid-cols-4";
const tileClass = "relative overflow-hidden rounded-lg aspect-3/2 bg-muted";
---

<section id="how-it-works" class="scroll-mt-20">
  <Wrapper variant="standard" class="py-24">
    <SectionHeading title="From first call to keys">
      A move should feel like a milestone, not a transaction to endure. Choose buying or
      selling to see what happens at each step, and what I will need from you along the way.
    </SectionHeading>
    <div
      role="tablist"
      aria-label="Buying or selling"
      class="inline-flex gap-1 p-1 mt-8 border rounded-full bg-muted border-border"
    >
      {
        tabs.map((tab, index) => (
          <Button
            variant="none"
            size="sm"
            type="button"
            role="tab"
            id={`process-tab-${tab.id}`}
            aria-controls={`process-panel-${tab.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-process-tab
            class="text-muted-foreground hover:text-foreground aria-selected:bg-foreground aria-selected:text-background focus:outline-muted-foreground"
          >
            {tab.label}
          </Button>
        ))
      }
    </div>

    <div role="tabpanel" id="process-panel-buying" aria-labelledby="process-tab-buying">
      <ol class={gridClass} role="list">
        <StepCard
          tint="clay"
          label="Before you view"
          title="Call and budget"
          description="A relaxed 20-minute call about your plans, then a pre-approval, so you know your real number before you fall for a home."
        >
          <Checklist title="For your pre-approval" items={preApproval} />
        </StepCard>
        <StepCard
          tint="sage"
          label="The search"
          title="Shortlist and showings"
          description="I filter the listings so you only tour homes that fit. After each showing you get my honest read, the good and the bad."
        >
          <div class={rowClass}>
            <p class={cardTitleClass}>New this week</p>
            <p class={cardTitleClass}>Example</p>
          </div>
          <p class={`${figureClass} flex items-baseline gap-2`}>
            <span>{`${shortlist.length} of ${newListings}`}</span>
            <span class="text-xs font-medium tracking-normal">worth a visit</span>
          </p>
          <div class="flex gap-1 mt-3" aria-hidden="true">
            {
              Array.from({ length: newListings }).map((_, index) => (
                <span
                  class:list={[
                    "flex-1 h-4 rounded-full",
                    index < newListings - shortlist.length ? "bg-foreground" : "bg-accent",
                  ]}
                />
              ))
            }
          </div>
          <ul class="mt-3 space-y-2" role="list">
            {
              shortlist.map((item) => (
                <li class={rowClass}>
                  <span class={rowLabelClass}>{item.home}</span>
                  <span class={rowValueClass}>{item.beds}</span>
                </li>
              ))
            }
          </ul>
        </StepCard>
        <StepCard
          tint="sand"
          label="The offer"
          title="Offer and subjects"
          description="We set price and terms from recent sales, not guesswork. Then each subject is cleared before anything is firm."
        >
          <Checklist title="Subjects to clear" items={subjects} />
        </StepCard>
        <StepCard
          tint="sky"
          label="Closing day"
          title="Completion and keys"
          description="Deposit, signing, completion and possession, each on the calendar. After you move in, I check in on your home's value every year."
        >
          <div class={rowClass}>
            <p class={cardTitleClass}>Offer to keys</p>
            <p class={cardTitleClass}>Example</p>
          </div>
          <ol class="mt-3 space-y-2" role="list">
            {
              milestones.map((item, index) => (
                <li class="flex items-center gap-2">
                  <span
                    class:list={[
                      "rounded-full size-2 shrink-0",
                      index === milestones.length - 1 ? "bg-accent" : "bg-foreground",
                    ]}
                  />
                  <span class={`${rowLabelClass} grow`}>{item.label}</span>
                  <span class={rowValueClass}>{item.day}</span>
                </li>
              ))
            }
          </ol>
        </StepCard>
      </ol>
      <Button isLink={true} href={agent.bookingUrl} target="_blank" rel="noopener noreferrer" variant="default" size="sm" class="mt-4 w-fit">
        Book a discovery call
      </Button>
    </div>

    <div role="tabpanel" id="process-panel-selling" aria-labelledby="process-tab-selling" hidden>
      <ol class={gridClass} role="list">
        <StepCard
          tint="clay"
          label="Before listing"
          title="Walkthrough and price"
          description="I walk every room, then send you a price range with the recent sales behind it. No pressure to list."
        >
          <div class={rowClass}>
            <p class={cardTitleClass}>Price range</p>
            <p class={cardTitleClass}>Example</p>
          </div>
          <p class={figureClass}>$879K to $915K</p>
          <div class="relative h-2 mt-3 rounded-full bg-muted" aria-hidden="true">
            <span class="absolute inset-y-0 w-1/3 rounded-full left-1/3 bg-accent"></span>
          </div>
          <dl class="mt-3 space-y-2">
            {
              comparables.map((item) => (
                <div class={rowClass}>
                  <dt class={rowLabelClass}>{item.label}</dt>
                  <dd class={rowValueClass}>{item.price}</dd>
                </div>
              ))
            }
          </dl>
        </StepCard>
        <StepCard
          tint="sage"
          label="Getting ready"
          title="Prepare the home"
          description="A short list of fixes that earn their cost back, plus cleaning and styling. Nothing goes ahead without your yes."
        >
          <Checklist title="Before the photos" items={preparation} />
        </StepCard>
        <StepCard
          tint="sand"
          label="Launch week"
          title="Photos, video and MLS®"
          description="Professional photos, a floor plan and a video tour, then your home goes live on MLS® and the team's channels."
        >
          <div class="grid grid-cols-2 gap-2">
            <div class={tileClass}>
              <Image src={HeroHouse} alt="" widths={[160, 240]} sizes="80px" quality={60} loading="lazy" decoding="async" aria-hidden="true" class="object-cover object-bottom size-full" />
            </div>
            <div class={tileClass}>
              <Image src={FirstHome} alt="" widths={[160, 240]} sizes="80px" quality={60} loading="lazy" decoding="async" aria-hidden="true" class="object-cover size-full" />
            </div>
            <div class={tileClass}>
              <Image src={VideoTour} alt="" widths={[160, 240]} sizes="80px" quality={60} loading="lazy" decoding="async" aria-hidden="true" class="object-cover object-left size-full" />
              <span class="absolute inset-0 flex items-center justify-center">
                <span class="flex items-center justify-center rounded-full size-6 bg-background text-foreground">
                  <Play class="size-3" />
                </span>
              </span>
            </div>
            <div class={`${tileClass} flex items-center justify-center text-foreground`}>
              <FloorPlan class="size-8" />
            </div>
          </div>
          <div class={`${rowClass} mt-3`}>
            <p class={rowLabelClass}>Photos and floor plan</p>
            <p class={rowValueClass}>Video tour</p>
          </div>
        </StepCard>
        <StepCard
          tint="sky"
          label="Offers to keys"
          title="Showings and offers"
          description="The highest offer is not always the strongest. I compare price, subjects and dates side by side, then see it through to completion."
        >
          <div class={rowClass}>
            <p class={cardTitleClass}>On the table</p>
            <p class={cardTitleClass}>Example</p>
          </div>
          <p class={figureClass}>{`${offers.length} offers`}</p>
          <ul class="mt-3 space-y-1" role="list">
            {
              offers.map((offer) => (
                <li class:list={[rowClass, "px-2 py-1 rounded-lg", offer.strongest && "bg-tint-sky"]}>
                  <span class={rowLabelClass}>{offer.price}</span>
                  <span class:list={["text-xs", offer.strongest ? "font-medium text-foreground" : "text-muted-foreground"]}>
                    {offer.terms}
                  </span>
                </li>
              ))
            }
          </ul>
        </StepCard>
      </ol>
      <Button isLink={true} href={agent.bookingUrl} target="_blank" rel="noopener noreferrer" variant="default" size="sm" class="mt-4 w-fit">
        Book a home valuation
      </Button>
    </div>

    <Text tag="p" variant="textXS" class="mt-8 text-muted-foreground">
      Figures and dates in the cards are examples. Yours come from your home, your budget and
      current sales.
    </Text>
  </Wrapper>
</section>

<script is:inline>
  (() => {
    // Buying / Selling tabs
    const tabs = [...document.querySelectorAll("[data-process-tab]")];
    const select = (tab, focus) => {
      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
        document.getElementById(item.getAttribute("aria-controls")).hidden = !selected;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(tabs[(index + step + tabs.length) % tabs.length], true);
      });
    });
    // Checklists keep their own tally as boxes are ticked
    document.querySelectorAll("[data-checklist]").forEach((list) => {
      const count = list.querySelector("[data-checklist-count]");
      list.addEventListener("change", () => {
        count.textContent = list.querySelectorAll("input:checked").length;
      });
    });
  })();
</script>
