---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import FancyLink from "@/components/fundations/elements/FancyLink.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import StoryBigCard from "@/components/stories/StoryBigCard.astro";
// Content
import { getCollection } from "astro:content";
const featuredStory = (await getCollection("stories"))
  .filter((story) => story.data.featured)
  .sort(
    (a, b) =>
      new Date(b.data.pubDate ?? 0).getTime() -
      new Date(a.data.pubDate ?? 0).getTime()
  )[0];
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="flex flex-wrap lg:items-center lg:justify-between">
      <Text
        tag="h2"
        variant="displayLG"
        class="font-semibold leading-none text-foreground tracking-tight text-balance uppercase"
        >Stories
      </Text>
      <FancyLink href="/stories">All stories</FancyLink>
    </div>
    <div class="mt-12">
      {featuredStory && <StoryBigCard story={featuredStory} />}
    </div>
  </Wrapper>
</section>
