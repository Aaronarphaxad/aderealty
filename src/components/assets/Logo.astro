---
import { Image } from "astro:assets";
import LogoMark from "@/images/agent/logo-mark.png";
import { agent } from "@/lib/agent";

const { class: className = "", ...rest } = Astro.props;
---

<span class={`flex items-center gap-2 min-w-0 ${className}`} {...rest}>
  <Image
    src={LogoMark}
    alt=""
    width={44}
    height={36}
    densities={[1, 2]}
    loading="eager"
    decoding="async"
    aria-hidden="true"
    class="h-8 w-auto shrink-0 sm:h-9"
  />
  <span class="text-sm font-medium leading-none tracking-tight truncate text-foreground">
    {agent.name}
  </span>
</span>
