---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import FancyLink from "@/components/fundations/elements/FancyLink.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div>
        <Text
          tag="h2"
          variant="displayLG"
          class="font-semibold leading-none text-foreground tracking-tight text-balance uppercase"
        >
          What you're looking for?
        </Text>
        <Text tag="p" variant="textSM" class="text-muted-foreground">
          We usually respond within 24 hours.
        </Text>
      </div>
      <form class="lg:col-span-2">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-y-12 gap-x-8">
          <div class="space-y-1">
            <label for="name" class="block text-sm text-foreground"
              >Your name</label
            >
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Tuva Ekholm"
              class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
            />
          </div>
          <div class="space-y-1">
            <label for="action" class="block text-sm text-foreground"
              >What do you want?</label
            >
            <select
              id="action"
              name="action"
              class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
            >
              <option>Buy</option>
              <option>Sell</option>
              <option>Rent</option>
            </select>
          </div>
          <div class="space-y-1">
            <label for="location" class="block text-sm text-foreground"
              >Your preferred location</label
            >
            <input
              type="text"
              id="location"
              name="location"
              placeholder="Östermalm"
              class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
            />
          </div>
          <div class="space-y-1">
            <label for="budget" class="block text-sm text-foreground"
              >Your desired budget</label
            >
            <input
              type="text"
              id="budget"
              name="budget"
              placeholder="$500,000"
              class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
            />
          </div>
          <div class="space-y-1">
            <label for="email" class="block text-sm text-foreground"
              >Your email address</label
            >
            <input
              type="email"
              id="email"
              name="email"
              placeholder="tuva@ekholm.test"
              class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
            />
          </div>
          <div class="space-y-1">
            <label for="phone" class="block text-sm text-foreground"
              >Your phone number</label
            >
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="+46 70 000 00 00"
              class="w-full h-12 px-0 py-2 text-xs text-foreground bg-transparent border-b border-transparent placeholder:text-muted-foreground border-b-border focus:outline-none focus:border-b-foreground focus:ring-0 appearence-none"
            />
          </div>
        </div>

        <div class="flex items-center mt-12 gap-12">
          <Button variant="muted" size="xs" type="submit" class="w-fit">
            Get your estimate
          </Button>
          <FancyLink href="/valuation/" variant="dark" textSizeClass="text-xs">
            Get a valuation
          </FancyLink>
        </div>
      </form>
    </div>
  </Wrapper>
</section>
