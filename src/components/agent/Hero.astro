---
// Assets
import { Picture } from "astro:assets";
import HeroHouse from "@/images/agent/hero-house.webp";
import Portrait from "@/images/agent/portrait.jpg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
import { agent } from "@/lib/agent";
---

<section id="top" class="relative overflow-hidden min-h-svh">
  <div class="absolute inset-0 pointer-events-none max-lg:mask-t-from-50% mask-b-from-80%">
    <div class="size-full lg:mask-linear-135 lg:mask-linear-from-transparent lg:mask-linear-from-20% lg:mask-linear-to-black lg:mask-linear-to-55%">
      <!-- LCP image: AVIF/WebP, priority fetch, mobile-first widths (Lighthouse uses ~412px). -->
      <Picture
        src={HeroHouse}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        alt={`Family homes in ${agent.address.city}, British Columbia`}
        widths={[360, 480, 640, 800, 960, 1160]}
        sizes="100vw"
        quality={70}
        priority
        pictureAttributes={{ class: "contents" }}
        class="object-cover object-bottom lg:object-center size-full"
      />
    </div>
  </div>
  <Wrapper variant="standard" class="relative z-10 pt-32 pb-12 lg:pb-24">
    <Text
      tag="h1"
      variant="display2XL"
      class="font-medium leading-none tracking-tighter text-foreground text-balance lg:text-pretty"
    >
      <span class="block lg:pl-48 2xl:pl-64">{agent.tagline.split(" ").slice(0, 3).join(" ")}</span>
      <span class="block">{agent.tagline.split(" ").slice(3).join(" ")}.</span>
    </Text>
    <div class="flex items-start max-w-lg gap-4 mt-8">
      <Picture
        src={Portrait}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        alt={`${agent.name}, ${agent.title}`}
        width={72}
        height={96}
        densities={[1, 2]}
        quality={65}
        loading="eager"
        fetchpriority="low"
        pictureAttributes={{ class: "contents" }}
        class="object-cover object-[center_12%] rounded-lg w-16 h-24 shrink-0"
      />
      <Text tag="p" variant="textLG" class="text-left text-muted-foreground">
        Hi, I'm {agent.shortName}. I help people buy, sell and invest across Surrey, Vancouver and the Lower Mainland.
      </Text>
    </div>
    <div class="flex flex-wrap gap-3 mt-8">
      <Button isLink={true} href="#first-home" variant="default" size="sm" class="w-fit">
        I'm buying
      </Button>
      <Button isLink={true} href="#contact" variant="outline" size="sm" class="w-fit">
        I'm selling
      </Button>
    </div>
  </Wrapper>
</section>
