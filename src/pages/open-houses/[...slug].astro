---
import { getCollection, render } from "astro:content";
import OpenHouseLayout from "@/layouts/OpenHouseLayout.astro";
export async function getStaticPaths() {
  const openHouses = await getCollection("openHouses");
  const paths = openHouses.map((page) => {
    return {
      params: { slug: page.id },
      props: { page },
      trailingSlash: false,
    };
  });
  return paths;
}
const { page } = Astro.props;
const { Content } = await render(page);
---

<OpenHouseLayout frontmatter={page.data}>
  <Content />
</OpenHouseLayout>
